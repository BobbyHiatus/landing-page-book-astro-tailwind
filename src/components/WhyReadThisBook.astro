---
import Instagram from './icons/Instagram.astro';
import Linkedin from './icons/Linkedin.astro';
import Twitter from './icons/Twitter.astro';
import { author, book, whyRead, sections } from '../config.json';

const rest = book.blurb.slice(book.heroParagraphs ?? 3);
const hasSocial = author.instagramUrl || author.twitterUrl || author.linkedinUrl;
---

<div class='bg-gray-50'>
  <div class='max-w-screen-xl mx-auto py-16 px-4'>
    <h2 class='text-5xl mb-10 font-semibold text-gray-900'>{whyRead.title}</h2>

    {whyRead.list.length > 0 && (
      <div class='grid gap-6 sm:grid-cols-2 mb-12'>
        {whyRead.list.map((item) => (
          <div class='bg-white rounded-lg shadow-sm p-6'>
            <h3 class='text-xl font-semibold text-gray-900 mb-2'>{item.title}</h3>
            <p class='text-gray-600 font-body'>{item.description}</p>
          </div>
        ))}
      </div>
    )}

    <div class='max-w-3xl text-lg text-gray-600 font-body'>
      {rest.map((block) =>
        typeof block === 'string' ? (
          <p class='mb-4'>{block}</p>
        ) : (
          <ul class='list-disc pl-6 mb-4 space-y-1'>
            {block.list.map((li) => <li>{li}</li>)}
          </ul>
        )
      )}
    </div>

    {sections.showAboutAuthor && (
      <div class='mt-12 flex-none sm:flex sm:items-start gap-8'>
        {author.photo && (
          <img class='mb-4 rounded-md w-48 h-48 object-cover' src={author.photo} alt={author.name} />
        )}
        <div class='text-lg text-gray-600 font-body'>
          <h3 class='text-2xl font-semibold text-gray-900 mb-2'>About {author.name}</h3>
          {author.bio.map((p) => <p class='mb-4'>{p}</p>)}
          {author.location && <p class='text-sm italic text-gray-500'>{author.location}</p>}
          {hasSocial && (
            <div class='flex flex-row my-2'>
              {author.instagramUrl && <a title='Instagram' href={author.instagramUrl} target='_blank'><Instagram /></a>}
              {author.twitterUrl && <a title='Twitter' href={author.twitterUrl} target='_blank'><Twitter /></a>}
              {author.linkedinUrl && <a title='LinkedIn' href={author.linkedinUrl} target='_blank'><Linkedin /></a>}
            </div>
          )}
        </div>
      </div>
    )}
  </div>
</div>
