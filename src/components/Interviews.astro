---
import { interviews } from '../config.json';
---

{interviews.list.length > 0 && (
  <div class='bg-white'>
    <div class='max-w-screen-xl mx-auto px-4 py-12 md:py-16'>
      <h2 class='text-4xl mb-8 font-semibold text-gray-900'>{interviews.title}</h2>
      <div class='grid gap-8 md:grid-cols-2'>
        {interviews.list.map((item) => (
          <blockquote class='border-l-4 border-book-theme pl-6'>
            <p class='text-lg text-gray-700 font-body'>{item.summary}</p>
            <footer class='mt-3 text-sm text-gray-500'>
              {item.url ? <a class='underline' href={item.url} target='_blank'>{item.name}</a> : item.name}
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </div>
)}
