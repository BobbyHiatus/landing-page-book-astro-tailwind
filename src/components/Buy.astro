---
import { showCountingSell, sectionPrices, buy } from '../config.json';
import Checkmark from './icons/Checkmark.astro';

const cards = [
  { key: 'priceLeft', main: false },
  { key: 'priceMain', main: true },
  { key: 'priceRight', main: false },
]
  .map((c) => ({ ...c, data: sectionPrices[c.key] }))
  .filter((c) => c.data);

const pad = (n) => String(n).padStart(2, '0');
---

<div id='buy' class='bg-book-gray'>
  <div class='pt-12 px-4 sm:px-6 lg:px-8 lg:pt-20 text-center'>
    <p class='text-3xl leading-9 font-extrabold text-white sm:text-4xl lg:text-5xl lg:leading-none'>
      {buy.title}
    </p>
    <p class='mt-3 max-w-4xl mx-auto text-xl leading-7 text-gray-300 sm:mt-5 font-body'>
      {buy.description}
    </p>
  </div>
  <div class='mt-12 bg-white pb-12 lg:mt-16 lg:pb-20'>
    <div class='relative'>
      <div class='absolute inset-0 h-1/2 bg-book-gray'></div>
      <div class='relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8'>
        <div class={`grid gap-8 ${cards.length === 3 ? 'lg:grid-cols-3' : 'md:grid-cols-2'}`}>
          {cards.map(({ data, main }) => (
            <div class={`relative flex flex-col rounded-lg shadow-xl overflow-hidden bg-white ${main ? 'ring-2 ring-book-theme' : ''}`}>
              {main && buy.tag && (
                <div class='flex justify-center pt-4'>
                  <span class='inline-flex rounded-full text-book-gray bg-book-theme px-4 py-1 text-sm font-semibold tracking-wider uppercase'>
                    {buy.tag}
                  </span>
                </div>
              )}
              <div class='px-6 py-8 text-center'>
                <h3 class='text-2xl font-semibold text-book-gray'>{data.title}</h3>
                <div class='mt-4 flex items-start justify-center text-book-gray'>
                  <span class='text-2xl font-medium mt-2'>$</span>
                  <span class='text-6xl font-extrabold tracking-tight'>{data.amount.decimal}</span>
                  <span class='text-2xl font-medium mt-2'>.{pad(data.amount.cents)}</span>
                </div>
                {data.previousAmount && (
                  <p class='line-through font-light text-gray-500'>{data.previousAmount}</p>
                )}
              </div>
              <div class='flex-1 flex flex-col justify-between border-t-2 border-gray-100 p-6 bg-gray-50'>
                <ul class='space-y-4'>
                  {data.details.map((item) => (
                    <li class='flex items-start'>
                      <div class='flex-shrink-0'><Checkmark /></div>
                      <p class='ml-3 text-base font-medium text-gray-500'>{item}</p>
                    </li>
                  ))}
                </ul>
                <a
                  target='_blank'
                  rel='noopener'
                  href={data.button.url}
                  class='mt-8 block w-full text-center rounded-lg px-6 py-4 text-lg font-semibold text-book-gray bg-book-theme hover:bg-yellow-200 transition duration-300 ease-in-out'
                >
                  {data.button.label}
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    {showCountingSell && buy.copiesSold && (
      <p class='text-center text-base text-gray-700 mt-10'>
        More than <span class='font-semibold'>{buy.copiesSold} copies</span> sold
      </p>
    )}
  </div>
</div>
