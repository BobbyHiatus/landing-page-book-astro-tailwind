---
export interface Props {
  book: { slug: string; title: string; subtitle?: string; cover: string; featured?: boolean };
}
const { book } = Astro.props;
const href = book.featured ? '/' : `/books/${book.slug}`;
---

<a href={href} class='group block'>
  <div class='aspect-[2/3] overflow-hidden rounded-md shadow-md bg-gray-100 transition duration-300 group-hover:shadow-xl group-hover:-translate-y-1'>
    <img src={book.cover} alt={book.title} loading='lazy' class='w-full h-full object-contain' />
  </div>
  <h3 class='mt-3 font-semibold text-gray-900 leading-snug group-hover:underline'>{book.title}</h3>
  {book.subtitle && <p class='mt-1 text-sm text-gray-500 font-body leading-snug'>{book.subtitle}</p>}
</a>
