---
import { whatsInside } from '../config.json';
---

<div class='bg-book-gray relative overflow-hidden'>
  <div class='max-w-screen-xl mx-auto pt-16 pb-12 px-4'>
    <h2 class='text-5xl mb-10 font-semibold text-gray-50'>{whatsInside.title}</h2>
    <div class='grid gap-8 sm:grid-cols-2'>
      {whatsInside.list.map((item) => (
        <div>
          <h3 class='text-xl mb-2 text-book-theme font-semibold'>{item.title}</h3>
          <p class='text-gray-300 font-body'>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</div>
