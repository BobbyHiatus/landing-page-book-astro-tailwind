---
import Layout from '../layouts/Layout.astro';
import MoreBooks from '../components/MoreBooks.astro';
import Footer from '../components/Footer.astro';
---

<Layout title='Page not found'>
  <main class='max-w-screen-xl mx-auto px-4 sm:px-6 py-20 text-center'>
    <h1 class='text-4xl font-extrabold text-gray-900'>Page not found</h1>
    <p class='mt-4 text-lg text-gray-600 font-body'>That page doesn't exist. <a class='underline' href='/'>Go to the home page</a>.</p>
  </main>
  <MoreBooks />
  <Footer />
</Layout>
