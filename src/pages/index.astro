---
import WhyReadThisBook from '../components/WhyReadThisBook.astro';
import HeroSection from '../components/HeroSection.astro';
import Layout from '../layouts/Layout.astro';
import Interviews from '../components/Interviews.astro';
import FreeChapter from '../components/FreeChapter.astro';
import WhatsInside from '../components/WhatsInside.astro';
import Buy from '../components/Buy.astro';
import Footer from '../components/Footer.astro';
import AudioBook from '../components/AudioBook.astro';
import MoreBooks from '../components/MoreBooks.astro';
import { sections, book } from '../config.json';
---

<Layout>
  <HeroSection />
  <WhyReadThisBook />
  {sections.showBuyAudiobook && <AudioBook />}
  <Interviews />
  {sections.showDownloadFreeChapter && <FreeChapter />}
  <WhatsInside />
  <Buy />
  <MoreBooks exclude='the-geometry-of-flow' />
  <Footer />
</Layout>
